# -----------------------------------------------------------------------------
# DentaVoice Coach — Environment Configuration
# -----------------------------------------------------------------------------
# Copy this file to .env.local and fill in your API keys.
# .env.local is git-ignored and stays on your machine.
# -----------------------------------------------------------------------------

# Anthropic API key — get from https://console.anthropic.com/settings/keys
# Used server-side only. Never exposed to browser.
ANTHROPIC_API_KEY=sk-ant-api03-...

# Deepgram API key — SERVER-SIDE ONLY. Auth happens in the server.js
# WebSocket proxy. The browser never sees this key anymore.
# (NEXT_PUBLIC_DEEPGRAM_API_KEY is no longer used — you can delete it.)
DEEPGRAM_API_KEY=...

# Claude model override. Leave unset for the auto path:
#   Haiku 4.5 by default (fast), Sonnet only in recovery (3+ nulls).
# COACH_MODEL=claude-sonnet-4-6

# Escalate to Sonnet after 5+ hints (pitch/close territory).
# OFF by default — it adds ~1s+ latency exactly when speed matters.
# COACH_ESCALATE_DEEP=true

# Polling interval in milliseconds — the fallback timer between coach calls.
# Most hints now fire event-driven on prospect speech, so this matters less.
NEXT_PUBLIC_COACH_POLL_INTERVAL_MS=4000

# Legacy — the coach now receives the FULL call transcript. This value only
# exists for prop compatibility and no longer trims what Claude sees.
NEXT_PUBLIC_COACH_WINDOW_SECONDS=60

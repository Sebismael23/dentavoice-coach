# -----------------------------------------------------------------------------
# DentaVoice Coach — Environment Configuration
# -----------------------------------------------------------------------------
# Copy this file to .env.local and fill in your API keys.
# .env.local is git-ignored and stays on your machine.
# -----------------------------------------------------------------------------

# Anthropic API key — get from https://console.anthropic.com/settings/keys
# Used server-side only. Never exposed to browser.
ANTHROPIC_API_KEY=sk-ant-api03-...

# Deepgram API key — get from https://console.deepgram.com/
# Used client-side for live transcription. OK for local personal use.
# For production/multi-user, swap to temporary-key flow via server.
NEXT_PUBLIC_DEEPGRAM_API_KEY=...

# Claude model string. Defaults to Sonnet 4.6 (best quality).
# To cut cost ~80% with slight quality drop, use: claude-haiku-4-5-20251001
COACH_MODEL=claude-sonnet-4-6

# Polling interval in milliseconds (how often we ask Claude for a hint)
# 3000 = 3 seconds. Lower = more responsive but more API calls. Sweet spot 3000-5000.
# NEXT_PUBLIC_ prefix required so the browser can read these values.
NEXT_PUBLIC_COACH_POLL_INTERVAL_MS=4000

# Rolling transcript window in seconds — how much context we send to Claude
NEXT_PUBLIC_COACH_WINDOW_SECONDS=60
